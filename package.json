{
  "name": "ember-pomodoro",
  "productName": "Ember",
  "version": "1.0.0",
  "description": "A transparent, always-on-top pomodoro strip for Windows 11",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.js",
    "dist": "node scripts/check-assets.js && electron-builder --win portable",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}

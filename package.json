{
  "name": "ember-pomodoro",
  "productName": "Ember",
  "version": "1.0.0",
  "description": "A transparent, always-on-top pomodoro strip for Windows 11",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "electron-builder --win portable"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "dev.sigmund.ember",
    "productName": "Ember",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "settings.html",
      "widget.css",
      "common.js"
    ],
    "win": {
      "target": "portable"
    }
  }
}

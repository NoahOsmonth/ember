{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run test/unit/core/timer.test.js test/unit/core/timer.properties.test.js test/unit/core/timer.purity.test.js"
  },
  "tsconfigFile": "stryker.tsconfig.json",
  "mutate": ["src/core/timer.js"],
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 30000,
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 70
  }
}
